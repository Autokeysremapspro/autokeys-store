{
  "functions": {
    "api/render-seo.js": {
      "includeFiles": "{producto.html,tienda.html,blog-post.html}"
    }
  },
  "crons": [
    { "path": "/api/recordar-carritos", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/blog-post.html", "destination": "/api/legacy-seo-redirect?type=blog" },
    { "source": "/producto.html", "destination": "/api/legacy-seo-redirect?type=product" },
    { "source": "/reparacion-centralitas-ecu", "destination": "/api/seo-landing?slug=reparacion-centralitas-ecu" },
    { "source": "/clonacion-centralitas-ecu", "destination": "/api/seo-landing?slug=clonacion-centralitas-ecu" },
    { "source": "/reparacion-centralita-por-envio", "destination": "/api/seo-landing?slug=reparacion-centralita-por-envio" },
    { "source": "/programacion-llaves-coche", "destination": "/api/seo-landing?slug=programacion-llaves-coche" },
    { "source": "/perdida-total-llaves-coche", "destination": "/api/seo-landing?slug=perdida-total-llaves-coche" },
    { "source": "/duplicado-llaves-coche-jaen", "destination": "/api/seo-landing?slug=duplicado-llaves-coche-jaen" },
    { "source": "/bmw-fem-bdc", "destination": "/api/seo-landing?slug=bmw-fem-bdc" },
    { "source": "/mercedes-ezs-elv", "destination": "/api/seo-landing?slug=mercedes-ezs-elv" },
    { "source": "/reparacion-airbag-srs", "destination": "/api/seo-landing?slug=reparacion-airbag-srs" },
    { "source": "/reprogramacion-centralitas-jaen", "destination": "/reprogramacion-centralitas-jaen.html" },
    { "source": "/servicios/:slug", "destination": "/api/render-seo?type=product&slug=:slug" },
    { "source": "/productos/:slug", "destination": "/api/render-seo?type=product&slug=:slug" },
    { "source": "/categorias/:slug", "destination": "/api/render-seo?type=category&slug=:slug" },
    { "source": "/guias/:slug", "destination": "/api/guide-seo?slug=:slug" },
    { "source": "/casos/land-rover-discovery-4-2015-llave-rfa-autel", "destination": "/api/case-seo-extra?slug=land-rover-discovery-4-2015-llave-rfa-autel" },
    { "source": "/casos/opel-combo-md1cs003-recuperacion-arranque", "destination": "/api/case-seo-extra?slug=opel-combo-md1cs003-recuperacion-arranque" },
    { "source": "/casos/renault-kangoo-2007-uch-reparada", "destination": "/api/case-seo-extra?slug=renault-kangoo-2007-uch-reparada" },
    { "source": "/casos/golf-5-gti-med9-1-pops-bangs-tirones-corregidos", "destination": "/api/case-seo-extra?slug=golf-5-gti-med9-1-pops-bangs-tirones-corregidos" },
    { "source": "/casos/golf-4-1-9-tdi-asz-stage-2-hardcut", "destination": "/api/case-seo-extra2?slug=golf-4-1-9-tdi-asz-stage-2-hardcut" },
    { "source": "/casos/seat-ibiza-6l-multimapa-hardcut", "destination": "/api/case-seo-extra2?slug=seat-ibiza-6l-multimapa-hardcut" },
    { "source": "/casos/bmw-f36-420d-codificacion-levas", "destination": "/api/case-seo-extra2?slug=bmw-f36-420d-codificacion-levas" },
    { "source": "/casos/seat-leon-mk1-1-8-pops-bangs", "destination": "/api/case-seo-extra3?slug=seat-leon-mk1-1-8-pops-bangs" },
    { "source": "/casos/desarrollo-edc15p-multimapa-autokeys", "destination": "/api/case-seo-extra3?slug=desarrollo-edc15p-multimapa-autokeys" },
    { "source": "/casos/mercedes-2008-2009-ezs-inoperativo-dos-llaves", "destination": "/api/case-seo-extra4?slug=mercedes-2008-2009-ezs-inoperativo-dos-llaves" },
    { "source": "/casos/:slug", "destination": "/api/case-seo?slug=:slug" }
  ]
}
