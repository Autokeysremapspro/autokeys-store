{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/render-seo.js": {
      "includeFiles": "{producto.html,tienda.html,blog-post.html}"
    }
  },
  "crons": [
    { "path": "/api/recordar-carritos", "schedule": "0 * * * *" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "autokeysremapspro.es" }],
      "destination": "https://www.autokeysremapspro.es/:path*",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "ecu-uce" }],
      "destination": "/categorias/ecu-uce",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "clonacion-ecu" }],
      "destination": "/categorias/clonacion-ecu",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "reparacion-ecu" }],
      "destination": "/categorias/reparacion-ecu",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "inmovilizadores" }],
      "destination": "/categorias/inmovilizadores",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "llaves" }],
      "destination": "/categorias/llaves",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "bmw-fem-bdc" }],
      "destination": "/categorias/bmw-fem-bdc",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "bmw-cas-ews" }],
      "destination": "/categorias/bmw-cas-ews",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "mercedes-ezs-elv" }],
      "destination": "/categorias/mercedes-ezs-elv",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "modulos" }],
      "destination": "/categorias/modulos",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "abs-esp" }],
      "destination": "/categorias/abs-esp",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "tcu-tcm" }],
      "destination": "/categorias/tcu-tcm",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "audi-j518-elv" }],
      "destination": "/categorias/audi-j518-elv",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "bmw-frm" }],
      "destination": "/categorias/bmw-frm",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "airbag-srs" }],
      "destination": "/categorias/airbag-srs",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "cuadros" }],
      "destination": "/categorias/cuadros",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "software" }],
      "destination": "/categorias/software",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "reparacion-envio" }],
      "destination": "/categorias/reparacion-envio",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "diagnostico" }],
      "destination": "/categorias/diagnostico",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "herramientas" }],
      "destination": "/categorias/herramientas",
      "permanent": true
    },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat", "value": "audi-bcm2-kessy" }],
      "destination": "/categorias/audi-bcm2-kessy",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://www.autokeysremapspro.online/login",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://www.autokeysremapspro.online/:path*",
      "permanent": false
    },
    {
      "source": "/blog-post.html",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>.*)" }],
      "destination": "/guias/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/blog-post.html", "destination": "/api/legacy-seo-redirect?type=blog" },
    { "source": "/producto.html", "destination": "/api/legacy-seo-redirect?type=product" },
    {
      "source": "/tienda.html",
      "has": [{ "type": "query", "key": "cat" }],
      "destination": "/api/legacy-seo-redirect?type=shop"
    },

    { "source": "/guias/:file.html", "destination": "/api/legacy-seo-redirect?type=nested&file=:file" },
    { "source": "/casos/:file.html", "destination": "/api/legacy-seo-redirect?type=nested&file=:file" },
    { "source": "/servicios/:file.html", "destination": "/api/legacy-seo-redirect?type=nested&file=:file" },
    { "source": "/productos/:file.html", "destination": "/api/legacy-seo-redirect?type=nested&file=:file" },
    { "source": "/categorias/:file.html", "destination": "/api/legacy-seo-redirect?type=nested&file=:file" },

    { "source": "/duplicado-llaves-coche-jaen", "destination": "/api/seo-priority?slug=duplicado-llaves-coche-jaen" },
    { "source": "/reprogramacion-centralitas-jaen", "destination": "/api/seo-priority?slug=reprogramacion-centralitas-jaen" },
    { "source": "/reparacion-centralitas-ecu", "destination": "/api/seo-search-growth?slug=reparacion-centralitas-ecu" },

    { "source": "/inmovilizador-coche", "destination": "/api/seo-search-growth?slug=inmovilizador-coche" },
    { "source": "/programacion-llaves-coche", "destination": "/api/seo-priority2?slug=programacion-llaves-coche" },
    { "source": "/perdida-total-llaves-coche", "destination": "/api/seo-priority2?slug=perdida-total-llaves-coche" },
    { "source": "/clonacion-centralitas-ecu", "destination": "/api/seo-priority2?slug=clonacion-centralitas-ecu" },
    { "source": "/bmw-fem-bdc", "destination": "/api/seo-priority2?slug=bmw-fem-bdc" },
    { "source": "/mercedes-ezs-elv", "destination": "/api/seo-priority2?slug=mercedes-ezs-elv" },

    { "source": "/reparacion-centralita-por-envio", "destination": "/api/seo-landing?slug=reparacion-centralita-por-envio" },
    { "source": "/reparacion-airbag-srs", "destination": "/api/seo-search-growth?slug=reparacion-airbag-srs" },
    { "source": "/reparacion-cuadro-instrumentos", "destination": "/api/seo-cluster" },

    { "source": "/servicios/:slug", "destination": "/api/seo-health?kind=product&slug=:slug" },
    { "source": "/productos/:slug", "destination": "/api/seo-health?kind=product&slug=:slug" },
    { "source": "/categorias/:slug", "destination": "/api/seo-health?kind=category&slug=:slug" },
    { "source": "/guias/:slug", "destination": "/api/seo-health?kind=guide&slug=:slug" },
    { "source": "/casos/:slug", "destination": "/api/seo-health?kind=case&slug=:slug" }
  ]
}
