# Supabase (solo servidor)
SUPABASE_SERVICE_ROLE_KEY=

# MRW — solicitar estos valores al equipo técnico de MRW.
MRW_ENVIRONMENT=sandbox
MRW_API_BASE_URL=
MRW_CREATE_PATH=/shipments
MRW_TEST_PATH=

# Autenticación admitida: basic, bearer, api-key o none.
MRW_AUTH_TYPE=basic
MRW_USERNAME=
MRW_PASSWORD=
MRW_API_KEY=
MRW_API_KEY_HEADER=X-API-Key

# Datos del contrato.
MRW_CUSTOMER_CODE=
MRW_FRANCHISE_CODE=
MRW_SERVICE_CODE=24H

# Ajustables si MRW usa otros nombres en su respuesta JSON.
MRW_TRACKING_FIELD=numero_seguimiento
MRW_LABEL_FIELD=etiqueta_url

# Valores operativos.
MRW_DEFAULT_WEIGHT_KG=1
MRW_TIMEOUT_MS=15000
